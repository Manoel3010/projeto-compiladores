/* Programa: maximo divisor comum de 48 e 18 pelo algoritmo de Euclides.
   Resultado esperado: 6. Exercita 'while', o operador '%' e o pipeline. */
{
    int a;
    int b;
    int t;

    a = 48;
    b = 18;

    while (b != 0) {
        t = b;
        b = a % b;
        a = t;
    }

    a |> print;
}
