Gramática

    0 $accept: program $end

    1 program: block

    2 block: '{' decls stmts '}'

    3 decls: decls decl
    4      | ε

    5 decl: type ID ';'

    6 type: INT
    7     | FLOAT
    8     | BOOL
    9     | CHAR

   10 stmts: stmts stmt
   11      | ε

   12 stmt: expr ';'
   13     | IF '(' expr ')' stmt
   14     | IF '(' expr ')' stmt ELSE stmt
   15     | WHILE '(' expr ')' stmt
   16     | DO stmt WHILE '(' expr ')' ';'
   17     | FOR ID IN expr RANGE expr block
   18     | FOR ID IN expr RANGE expr STEP expr block
   19     | BREAK ';'
   20     | CONTINUE ';'
   21     | block

   22 expr: ID '=' expr
   23     | expr PIPE ID
   24     | expr OR expr
   25     | expr AND expr
   26     | expr EQ expr
   27     | expr NE expr
   28     | expr '<' expr
   29     | expr '>' expr
   30     | expr LE expr
   31     | expr GE expr
   32     | expr '+' expr
   33     | expr '-' expr
   34     | expr '*' expr
   35     | expr '/' expr
   36     | expr '%' expr
   37     | '!' expr
   38     | '-' expr
   39     | '(' expr ')'
   40     | ID
   41     | NUM
   42     | REAL
   43     | TRUE
   44     | FALSE


