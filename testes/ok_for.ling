{
    int i;
    int j;
    int soma;

    soma = 0;

    // for simples
    for i in 0..10 {
        soma = soma + i;
    }

    // for com step
    for i in 0..100 step 5 {
        soma = soma + i;
    }

    // for aninhado, com break e continue no corpo
    for i in 0..3 {
        for j in 0..9 step 2 {
            if (j > 4) {
                break;
            }
            if (j == 2) {
                continue;
            }
            soma = soma + i * j;
        }
    }

    // limites do range podem ser expressoes
    for i in soma..soma + 10 step j {
        soma = soma - 1;
    }
}
